#!/usr/bin/env bash
# solc-rocq — wrapper that invokes the rocq-of-solidity solc fork.
#
# On native linux/x86_64 hosts the script invokes the solc binary
# directly (fast). On other hosts (macOS, linux/arm64) it falls back
# to running the same binary inside a coqorg/coq Docker container
# with --platform=linux/amd64 (slow under QEMU, but portable).
#
# Force one path or the other via SOLC_ROCQ_MODE=native|docker.
#
# Usage:
#   ./solc-rocq <flags> <input.sol>
#
# Override locations via env vars if your layout differs:
#   ROCQ_TREE       Path to a built rocq-of-solidity checkout.
#                   Default: $HOME/git/reserve/_tools/rocq-of-solidity
#   REPO_TREE       Path to this repository (the one containing
#                   formal-verification/). Default: self-locate from script.
#   DOCKER_CONTEXT  Docker context to use. Default: current default.
#   SOLC_ROCQ_MODE  'native' or 'docker'. Default: auto-detect from uname.

set -euo pipefail

ROCQ_TREE="${ROCQ_TREE:-$HOME/git/reserve/_tools/rocq-of-solidity}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_TREE="${REPO_TREE:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

if [[ ! -x "$ROCQ_TREE/build/solc/solc" ]]; then
  cat >&2 <<EOF
error: rocq-of-solidity solc binary not found at:
  $ROCQ_TREE/build/solc/solc

Set ROCQ_TREE to point at a built rocq-of-solidity checkout, or build
the upstream. The project is a fork of the Solidity compiler; follow
its build instructions:

  https://github.com/formal-land/rocq-of-solidity#-quick-start
EOF
  exit 2
fi

# Mode selection: explicit env var > auto-detect.
# Native mode runs solc directly; docker mode runs the amd64 ELF in a
# coqorg/coq container under linux/amd64 (slow on non-Linux hosts via QEMU).
# Native mode picks the first existing binary from:
#   $ROCQ_TREE/build/solc/solc.<uname-flavour>   (platform-specific)
#   $ROCQ_TREE/build/solc/solc                   (default)
# This lets a single ROCQ_TREE hold both the amd64 ELF (for docker mode)
# and an arm64 macOS build (for native mode on Apple Silicon).
mode="${SOLC_ROCQ_MODE:-}"
if [[ -z "$mode" ]]; then
  if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]]; then
    mode=native
  elif [[ "$(uname -s)" == "Darwin" && -x "$ROCQ_TREE/build/solc/solc.macos-patched" ]]; then
    mode=native
  else
    mode=docker
  fi
fi

native_solc="$ROCQ_TREE/build/solc/solc"
if [[ "$(uname -s)" == "Darwin" && -x "$ROCQ_TREE/build/solc/solc.macos-patched" ]]; then
  native_solc="$ROCQ_TREE/build/solc/solc.macos-patched"
fi

# Foundry-style remappings.txt: solc accepts each remapping as a bare
# positional arg of the form prefix=path. Strip blank lines and comments,
# leave the rest as-is. Paths in remappings.txt are relative to REPO_TREE,
# which matches solc's interpretation when --base-path is set to REPO_TREE.
remappings=()
if [[ -f "$REPO_TREE/remappings.txt" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    remappings+=("$line")
  done < "$REPO_TREE/remappings.txt"
fi

case "$mode" in
  native)
    exec "$native_solc" \
      --base-path "$REPO_TREE" \
      --include-path "$REPO_TREE/node_modules" \
      --allow-paths "$REPO_TREE" \
      ${remappings[@]+"${remappings[@]}"} \
      "$@"
    ;;
  docker)
    DOCKER=(docker)
    if [[ -n "${DOCKER_CONTEXT:-}" ]]; then
      DOCKER+=(--context "$DOCKER_CONTEXT")
    fi
    "${DOCKER[@]}" run --rm \
      -v "$ROCQ_TREE":/work \
      -v "$REPO_TREE":/repo \
      -w /repo \
      --platform=linux/amd64 \
      coqorg/coq:8.20-ocaml-4.14-flambda \
      /work/build/solc/solc \
        --base-path /repo \
        --include-path /repo/node_modules \
        --allow-paths /repo \
        ${remappings[@]+"${remappings[@]}"} \
        "$@"
    ;;
  *)
    echo "error: unrecognised SOLC_ROCQ_MODE=$mode (expected 'native' or 'docker')" >&2
    exit 3
    ;;
esac
