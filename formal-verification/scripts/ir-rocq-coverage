#!/usr/bin/env bash
# ir-rocq-coverage — sweep every governor contract through solc-rocq
# --ir-rocq and tabulate pass/fail. Useful for catching regressions when
# upgrading rocq-of-solidity or adding new contracts.
#
# Usage:
#   ./formal-verification/scripts/ir-rocq-coverage [--keep-output]
#
# Flags:
#   --keep-output   keep the per-contract .out/.log files in $OUT_DIR
#                   (default: cleaned up after summary is printed)
#
# Env:
#   OUT_DIR         where to drop per-contract logs.
#                   Default: a fresh /tmp/ir_rocq_sweep.<pid>
#   SOLC_ROCQ       path to the wrapper.
#                   Default: <repo>/formal-verification/scripts/solc-rocq

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_TREE="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOLC_ROCQ="${SOLC_ROCQ:-$REPO_TREE/formal-verification/scripts/solc-rocq}"
OUT_DIR="${OUT_DIR:-/tmp/ir_rocq_sweep.$$}"

keep_output=0
for arg in "$@"; do
  case "$arg" in
    --keep-output) keep_output=1 ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

mkdir -p "$OUT_DIR"
summary="$OUT_DIR/summary.tsv"
printf 'result\texit\tsecs\tlines\tfile\tfirst_error\n' > "$summary"

cd "$REPO_TREE"

# Candidate set: any .sol declaring a contract or library, minus pure
# interfaces. We compile each in isolation to surface per-file issues
# (a project-wide compile masks them).
while IFS= read -r f; do
  log="$OUT_DIR/$(echo "$f" | tr '/' '_').log"
  out="$OUT_DIR/$(echo "$f" | tr '/' '_').out"
  t0=$(date +%s)
  set +e
  "$SOLC_ROCQ" --ir-rocq "$f" >"$out" 2>"$log"
  rc=$?
  set -e
  t1=$(date +%s)
  dur=$((t1 - t0))
  lines=$(wc -l < "$out" | tr -d ' ')
  if [[ $rc -eq 0 ]]; then
    res=PASS
    err=""
  else
    res=FAIL
    err=$(grep -m1 -E "Error:|terminate|length_error|Assertion" "$log" || head -1 "$log")
  fi
  printf '%s\t%d\t%d\t%s\t%s\t%s\n' "$res" "$rc" "$dur" "$lines" "$f" "$err" >> "$summary"
  printf '%-4s rc=%-3d t=%-3ds lines=%-7s %s\n' "$res" "$rc" "$dur" "$lines" "$f"
done < <(grep -lE '^(contract|library)[[:space:]]+[A-Z]' contracts -r 2>/dev/null \
           | grep -v interfaces | sort)

pass=$(grep -c '^PASS' "$summary" || true)
fail=$(grep -c '^FAIL' "$summary" || true)
tot=$(( $(wc -l < "$summary") - 1 ))
echo "---"
echo "PASS: $pass / $tot ; FAIL: $fail"

if [[ $keep_output -eq 0 ]]; then
  rm -rf "$OUT_DIR"
else
  echo "Per-contract logs kept in: $OUT_DIR"
fi

# Exit non-zero if anything failed, so this can be wired into CI.
[[ $fail -eq 0 ]]
