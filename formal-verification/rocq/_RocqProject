-R . ReserveGovernor
-Q /work/rocq/RocqOfSolidity RocqOfSolidity

-arg -impredicative-set
-arg -w
-arg -stdlib-vector

# Generated Yul-translation IR — produced by
# `bash scripts/solc-rocq --ir-rocq <contract.sol>`, captured under
# rocq/generated/. The smoke target below verifies the end-to-end
# toolchain (rocq-of-solidity library + amd64-on-arm64 solc fork) is
# wired correctly.
generated/Smoke.v

